{
  "id": "/",
  "name": "HearMeOut — Music Discovery & Story Soundtracks",
  "short_name": "HearMeOut",
  "description": "Find the perfect 30-second songs for your Instagram stories, reels, and playlists. Swipe right to save keepers straight to Spotify.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "portrait",
  "dir": "ltr",
  "lang": "en",
  "background_color": "#000000",
  "theme_color": "#000000",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "categories": ["music", "entertainment"]
}
